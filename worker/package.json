{
  "name": "newtab-party-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute newtab-party --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute newtab-party --remote --file=schema.sql",
    "logos": "node ../scripts/gen_logos.mjs",
    "retire": "node ../scripts/retire_game.mjs",
    "qa:lint": "node ../scripts/qa/lint.mjs",
    "qa:smoke": "node ../scripts/qa/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.4.0",
    "wrangler": "^4.90.1"
  }
}
